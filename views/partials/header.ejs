<% const role = typeof userRole !== 'undefined' ? userRole : 'user'; %>
<% const conta = (typeof usuarioLogado !== 'undefined' && usuarioLogado) ? usuarioLogado : { nome: 'Conta ativa', email: '', role: role }; %>
<% const iniciaisConta = (conta.nome || 'U').trim().split(/\s+/).slice(0, 2).map(p => p[0]).join('').toUpperCase(); %>
<% const rotuloPerfil = conta.role === 'admin' ? 'Administrador' : (conta.role === 'tecnico' ? 'Técnico' : 'Usuário'); %>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · HelpDesk TI</title>
  <meta name="description" content="HelpDesk TI — sistema local para abertura, acompanhamento e organização de chamados de suporte de TI.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-glow" aria-hidden="true"></div>
  <div class="app">
    <aside class="sidebar">
      <a href="/dashboard" class="brand" id="brand-link">
        <span class="brand-logo"><%- icon('zap', 20) %></span>
        <span class="brand-text">HelpDesk<strong>TI</strong></span>
      </a>

      <nav class="nav" aria-label="Navegação principal">
        <span class="nav-label">Geral</span>
        <a href="/dashboard" id="nav-dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>"><%- icon('dashboard') %><span>Dashboard</span></a>
        <a href="/tickets" id="nav-tickets" class="nav-link <%= currentPath.startsWith('/tickets') ? 'active' : '' %>"><%- icon('ticket') %><span>Chamados</span></a>

        <% if (role === 'admin' || role === 'tecnico') { %>
          <span class="nav-label">Cadastros</span>
          <a href="/technicians" id="nav-technicians" class="nav-link <%= currentPath.startsWith('/technicians') ? 'active' : '' %>"><%- icon('users') %><span>Técnicos</span></a>
          <a href="/categories" id="nav-categories" class="nav-link <%= currentPath.startsWith('/categories') ? 'active' : '' %>"><%- icon('tag') %><span>Categorias</span></a>
        <% } %>

        <% if (role === 'admin') { %>
          <span class="nav-label">Administração</span>
          <a href="/admin/users" id="nav-users" class="nav-link <%= currentPath.startsWith('/admin/users') ? 'active' : '' %>"><%- icon('users') %><span>Gestão de Usuários</span></a>
        <% } %>
      </nav>

      <div class="conta-card" id="conta-ativa-card" aria-label="Conta conectada"
           style="margin-top: auto; margin-bottom: 10px; padding: 12px; border-radius: 12px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09); display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
          <span class="avatar" id="conta-card-iniciais"><%= iniciaisConta %></span>
          <div style="display: flex; flex-direction: column; min-width: 0;">
            <strong id="conta-card-nome" style="font-size: 0.875rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= conta.nome %></strong>
            <span id="conta-card-email" style="font-size: 0.75rem; opacity: 0.75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= conta.email %></span>
          </div>
        </div>
        <span style="align-self: flex-start; font-size: 0.7rem; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: rgba(139, 92, 246, 0.18); color: #ddd6fe;">
          <%= rotuloPerfil %>
        </span>
      </div>

      <button type="button" id="btn-logout" class="btn btn-block sidebar-cta"
        style="background: #dc2626; border: 1px solid #dc2626; color: #ffffff;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Sair da conta</span>
      </button>
      <a href="/tickets/new" class="btn btn-primary btn-block sidebar-cta" id="sidebar-new-ticket"><%- icon('plus') %> Novo chamado</a>
    </aside>

    <main class="main">
      <% if (msg) { %>
        <div class="toast toast-success" role="status" data-toast><%- icon('check') %><span><%= msg %></span><button type="button" class="toast-close" aria-label="Fechar" data-toast-close><%- icon('x', 16) %></button></div>
      <% } %>
      <% if (erro) { %>
        <div class="toast toast-error" role="alert" data-toast><%- icon('alert') %><span><%= erro %></span><button type="button" class="toast-close" aria-label="Fechar" data-toast-close><%- icon('x', 16) %></button></div>
      <% } %>